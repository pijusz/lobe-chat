# ===========================================
# LobeChat VPS Deployment - Environment Template
# ===========================================
# Copy this file to .env and fill in your values
# Generate secrets with: openssl rand -base64 32

# ===========================================
# App Configuration
# ===========================================
LOBE_PORT=3210
APP_URL=https://your-domain.com

# ===========================================
# Secrets (REQUIRED - generate unique values!)
# ===========================================
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -base64 32
KEY_VAULTS_SECRET=

# ===========================================
# Database
# ===========================================
LOBE_DB_NAME=lobe_chat
# openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
POSTGRES_PASSWORD=

# ===========================================
# Better Auth SSO
# ===========================================
# Options: google, github, microsoft, apple (comma-separated)
AUTH_SSO_PROVIDERS=google

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
# Redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===========================================
# S3 Storage (Optional but recommended)
# ===========================================
# Vultr Object Storage, AWS S3, MinIO, etc.
S3_ENDPOINT=https://your-region.vultrobjects.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=https://your-bucket.your-region.vultrobjects.com

# ===========================================
# LLM Provider - OpenRouter (Recommended)
# ===========================================
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Model whitelist (use -all to disable defaults, then +model to add)
OPENROUTER_MODEL_LIST=-all,+x-ai/grok-4,+x-ai/grok-4-fast,+x-ai/grok-4.1-fast,+mistralai/ministral-8b,+mistralai/ministral-14b-2512,+mistralai/mistral-large-2512,+google/gemini-2.5-pro,+google/gemini-2.5-flash,+google/gemini-2.5-flash-lite,+openai/o4-mini,+openai/gpt-5.2,+openai/gpt-5.2-chat,+openai/gpt-5.2-pro,+deepseek/deepseek-v3.2,+meta-llama/llama-4-maverick,+meta-llama/llama-4-scout,+nvidia/nemotron-3-nano-30b-a3b:free,+z-ai/glm-4.6,+z-ai/glm-4.5-air:free

# Default model for new chats
DEFAULT_AGENT_CONFIG=model=google/gemini-2.5-flash,provider=openrouter

# ===========================================
# Branding (Optional)
# ===========================================
NEXT_PUBLIC_CUSTOM_BRAND=
NEXT_PUBLIC_LOGO_URL=/favicon.png

# ===========================================
# Alternative LLM Providers (Optional)
# ===========================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
